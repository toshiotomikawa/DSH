{
  "name": "@deepseek-ai/dsh-agent-runtime",
  "description": "Connects persistent agent identities to mailbox and routine sessions.",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/agents/agent-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./owners": {
      "types": "./lib/types/owners.d.ts",
      "default": "./lib/types/owners.js"
    },
    "./accounts": {
      "types": "./lib/types/accounts.d.ts",
      "default": "./lib/types/accounts.js"
    },
    "./account-auth": {
      "types": "./lib/types/account-auth.d.ts",
      "default": "./lib/types/account-auth.js"
    },
    "./account-tools": {
      "types": "./lib/types/account-tools.d.ts",
      "default": "./lib/types/account-tools.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-routine": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-agent-registry": "workspace:*",
    "@deepseek-ai/dsh-tool-agent-memory": "workspace:*",
    "@deepseek-ai/dsh-agent-mailbox": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-schedule": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-api-remote-access": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-session-query": "workspace:*",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-agent-memory": "workspace:*",
    "@deepseek-ai/dsh-tool-agent-mailbox": "workspace:*",
    "@deepseek-ai/dsh-tool-agent-routine": "workspace:*",
    "@deepseek-ai/dsh-tool-schedule": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "js-yaml": "^4.3.2",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-typert-registry": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
